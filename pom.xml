<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot manages versions of spring-kafka, kafka-clients, kafka-streams, Flyway, Jackson, Lettuce. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>com.example.payments</groupId>
  <artifactId>kafka-payments</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>kafka-payments</name>
  <description>Real-time payments: outbox, Kafka Streams fraud scoring, idempotent ledger</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <modules>
    <module>common-events</module>
    <module>outbox-support</module>
    <module>payment-api</module>
    <module>fraud-scoring</module>
    <module>ledger-service</module>
    <module>notification-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.example.payments</groupId>
        <artifactId>common-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.payments</groupId>
        <artifactId>outbox-support</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
